# ─── Required ────────────────────────────────────────────────────────────────

# Base URL of your Open WebUI instance (no trailing slash).
OPEN_WEBUI_URL=https://your-open-webui-instance.example.com


# ─── Automatic token renewal (recommended) ───────────────────────────────────
#
# Open WebUI tokens expire. With these set, the proxy logs in with a headless
# browser and keeps the token renewed on its own — no manual pasting.
#
# For SSO instances (e.g. Shibboleth + Duo), the first login may ask you to
# approve a Duo push. The browser session is then remembered, so later renewals
# are silent. Leave blank if your instance does not use SSO login.

UA_NETID=
UA_NETID_PASSWORD=


# ─── Manual token (alternative to the above) ─────────────────────────────────
#
# Paste a JWT from your browser session if you would rather not store
# credentials. NOTE: this expires and cannot be auto-renewed — you will have to
# replace it by hand. Ignored once a renewed token file exists.

USER_TOKEN=


# ─── Optional tuning ─────────────────────────────────────────────────────────

# Port the proxy listens on (host and container).
PORT=8000

# Upstream request timeout in seconds (10–3600).
REQUEST_TIMEOUT=300

# Max retries for empty upstream streams (0–10, 0 disables retry).
STREAM_EMPTY_RETRY_MAX=3

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
