FROM python:3.12-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget gnupg2 ca-certificates fonts-liberation libasound2 libatk-bridge2.0-0 \
    libatk1.0-0 libcups2 libdbus-1-3 libdrm2 libgbm1 libnspr4 libnss3 \
    libx11-xcb1 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libxss1 \
    libxtst6 libpango-1.0-0 libpangocairo-1.0-0 libwayland-client0 \
    libwayland-server0 libxkbcommon0 xvfb cron && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir . playwright PyJWT

RUN playwright install chromium

COPY src/ src/
COPY playwright_login.py .

RUN mkdir -p /etc/cron.d
COPY cron.d/proxy-refresh /etc/cron.d/proxy-refresh
RUN chmod 0644 /etc/cron.d/proxy-refresh

COPY entrypoint.sh .
RUN chmod +x entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["./entrypoint.sh"]
