FROM python:3.12-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget gnupg2 ca-certificates fonts-liberation libasound2 libatk-bridge2.0-0 \
    libatk1.0-0 libcups2 libdbus-1-3 libdrm2 libgbm1 libnspr4 libnss3 \
    libx11-xcb1 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libxss1 \
    libxtst6 libpango-1.0-0 libpangocairo-1.0-0 libwayland-client0 \
    libwayland-server0 libxkbcommon0 xvfb && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir . playwright PyJWT

# Install browsers at a fixed absolute path rather than the installer's $HOME.
# A HOME-relative path only resolves for the user that installed it, so the same
# image breaks if run under a different user (e.g. compose `user: 1000:1000` to
# keep /data files host-owned) — Playwright then looks in that user's home, finds
# nothing, and login crashes.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright

# Chromium is installed as appuser; /opt/ms-playwright is pre-created and
# world-readable so any runtime user can launch it.
RUN useradd --create-home --uid 10001 appuser && \
    mkdir -p /data /opt/ms-playwright && \
    chown -R appuser:appuser /data /app /opt/ms-playwright
USER appuser

RUN playwright install chromium && chmod -R a+rX /opt/ms-playwright

COPY --chown=appuser:appuser src/ src/
COPY --chown=appuser:appuser playwright_login.py .
COPY --chown=appuser:appuser entrypoint.sh .

ENV TOKEN_FILE=/data/token.json \
    BROWSER_PROFILE_DIR=/data/browser-profile

EXPOSE 8000

ENTRYPOINT ["./entrypoint.sh"]
